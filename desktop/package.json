{
  "name": "lumen-desktop",
  "productName": "Lumen",
  "version": "3.2.0",
  "description": "Lumen — Chromium-браузер",
  "author": "G1drohz",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "icon": "node scripts/make-icon.js",
    "predist": "node scripts/make-icon.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.g1drohz.lumen",
    "productName": "Lumen",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "adblock.js", "shared-path.js", "themes.js", "vault.js", "renderer/**/*"],
    "extraResources": [{ "from": "../shared", "to": "shared" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1049",
      "artifactName": "Lumen-Setup-${version}.${ext}"
    },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Network" }
  }
}
